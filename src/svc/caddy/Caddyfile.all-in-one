{$DCALCON_DOMAIN:localhost} {
	encode gzip zstd

	# Unified origin: DAV clients and the web UI share one host.
	handle /healthz {
		reverse_proxy core:8080
	}
	handle /readyz {
		reverse_proxy core:8080
	}
	handle /version {
		reverse_proxy core:8080
	}
	handle /api* {
		reverse_proxy core:8080
	}
	handle /.well-known/* {
		reverse_proxy core:8080
	}
	handle /dav* {
		reverse_proxy core:8080
	}
	handle /webcal* {
		reverse_proxy core:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
